# Copy to examples/node/.env (git-ignored) and fill in from the console:
# your Plexivo Postgres → Connect → Project URL and Publishable key.
PLEXIVO_URL=https://your-project-url-from-connect-tab
PLEXIVO_PUBLISHABLE_KEY=your-publishable-key

# Optional: the account the examples sign in as (created on first run).
# PLEXIVO_EXAMPLE_EMAIL=you@example.com
# PLEXIVO_EXAMPLE_PASSWORD=a long password

# Only for setup.ts, which creates the example tables from your machine.
# The secret key bypasses row-level security: never put it in an app.
# PLEXIVO_SECRET_KEY=your-secret-key
