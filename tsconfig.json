{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.d.ts", "generate-types.d.ts", "examples/*.ts", "examples/node/**/*.ts"],
  "exclude": ["examples/browser", "node_modules", "docs"]
}
