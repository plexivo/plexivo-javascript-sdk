{
  "name": "@plexivo/client",
  "version": "0.4.0",
  "description": "Plexivo Postgres for JavaScript and TypeScript: a Backend-as-a-Service on PostgreSQL. Auth, joins of every kind, Supabase-style and GORM-style queries, realtime, GraphQL live queries, raw SQL through the connection pooler, Plexivo Functions and files.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./generate-types": {
      "types": "./generate-types.d.ts",
      "import": "./src/generate-types.js"
    }
  },
  "bin": {
    "plexivo-generate-types": "scripts/generate-types.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:pooled": "POOLED=1 node test/e2e/run.mjs",
    "test:browser": "node test/browser/run.mjs",
    "test:docs": "node test/docs/run.mjs",
    "pack:check": "npm pack --dry-run",
    "docs": "typedoc",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "index.d.ts",
    "generate-types.d.ts",
    "src",
    "scripts",
    "examples",
    "!examples/browser/node_modules",
    "!examples/browser/dist",
    "!examples/**/.env",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "homepage": "https://plexivo.io/docs/#docs-postgres",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plexivo/plexivo-javascript-sdk.git"
  },
  "bugs": "https://github.com/plexivo/plexivo-javascript-sdk/issues",
  "keywords": [
    "plexivo",
    "backend-as-a-service",
    "baas",
    "firebase alternative",
    "firebase-alternative",
    "supabase-alternative",
    "postgres",
    "postgresql",
    "realtime",
    "auth",
    "authentication",
    "graphql",
    "live-queries",
    "serverless-functions",
    "database",
    "orm",
    "query-builder",
    "row-level-security",
    "react",
    "react-native",
    "vue"
  ],
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.62.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  }
}
