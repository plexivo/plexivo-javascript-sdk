# Copy to .env.local (git-ignored) and fill in from the console:
# your Plexivo Postgres → Connect → Project URL and Publishable key.
# Also add this app's origin (http://localhost:5173) to the Data API's allowed origins.
# Only the publishable key belongs in a browser. Never put the secret key here.
VITE_PLEXIVO_URL=https://your-project-url-from-connect-tab
VITE_PLEXIVO_PUBLISHABLE_KEY=your-publishable-key
