{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@plexivo/client",
  "entryPoints": ["index.d.ts", "generate-types.d.ts"],
  "out": "docs/api",
  "readme": "README.md",
  "tsconfig": "tsconfig.json",
  "excludeExternals": true,
  "highlightLanguages": ["bash", "console", "css", "html", "javascript", "json", "jsx", "jsonc", "json5", "sh", "sql", "tsx", "typescript", "yaml"],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true
}
